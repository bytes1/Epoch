pragma cashscript ^0.13.0;

contract MarketVault(bytes32 yesCategory, bytes32 noCategory, pubkey oraclePubKey, bytes4 marketId) {
    function mintCompleteSet(int shares) {
        require(shares > 0);
        require(this.activeInputIndex == 0);
        require(tx.inputs.length >= 3);
        require(tx.inputs[0].nftCommitment == 0x00);
        require(tx.inputs[1].tokenCategory == yesCategory + 0x02);
        require(tx.inputs[2].tokenCategory == noCategory + 0x02);
        require(tx.outputs[0].value == tx.inputs[0].value + shares * 1000);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].nftCommitment == 0x00);
        require(tx.outputs[1].tokenCategory == yesCategory + 0x02);
        require(tx.outputs[1].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.outputs[2].tokenCategory == noCategory + 0x02);
        require(tx.outputs[2].lockingBytecode == tx.inputs[2].lockingBytecode);
        require(tx.outputs[3].tokenCategory == yesCategory);
        require(tx.outputs[3].tokenAmount == shares);
        require(tx.outputs[4].tokenCategory == noCategory);
        require(tx.outputs[4].tokenAmount == shares);
    }

    function mergeCompleteSet(int shares) {
        require(shares > 0);
        require(this.activeInputIndex == 0);
        require(tx.inputs[0].nftCommitment == 0x00);
        require(tx.inputs[1].tokenCategory == yesCategory);
        require(tx.inputs[1].tokenAmount == shares);
        require(tx.inputs[2].tokenCategory == noCategory);
        require(tx.inputs[2].tokenAmount == shares);
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].value == tx.inputs[0].value - shares * 1000);
        require(tx.outputs[0].value >= 1000);
        require(tx.outputs[0].nftCommitment == 0x00);
    }

    function resolveMarket(datasig oracleSig, bytes1 outcome) {
        require(this.activeInputIndex == 0);
        require(tx.inputs[0].nftCommitment == 0x00);
        require(outcome == 0x01 || outcome == 0x02);
        require(checkDataSig(oracleSig, marketId + outcome, oraclePubKey));
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].nftCommitment == outcome);
        require(tx.outputs[0].value <= tx.inputs[0].value);
    }

    function redeemWinnings(int shares) {
        require(shares > 0);
        require(this.activeInputIndex == 0);
        require(tx.inputs[0].nftCommitment == 0x01 || tx.inputs[0].nftCommitment == 0x02);
        require(tx.inputs[1].tokenAmount == shares);
        require((tx.inputs[0].nftCommitment == 0x01 && tx.inputs[1].tokenCategory == yesCategory) ||
            (tx.inputs[0].nftCommitment == 0x02 && tx.inputs[1].tokenCategory == noCategory));
        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode);
        require(tx.outputs[0].value == tx.inputs[0].value - shares * 1000);
        require(tx.outputs[0].nftCommitment == tx.inputs[0].nftCommitment);
        require(tx.outputs[0].value >= 1000);
        require(tx.outputs[1].lockingBytecode == tx.inputs[1].lockingBytecode);
        require(tx.outputs[1].value == shares * 1000 - 1000);
        require(tx.outputs[1].tokenCategory == 0x);
    }
}
